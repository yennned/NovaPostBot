# =========================================================================
#  NovaPostBot — пример переменных окружения. Скопируй в .env и заполни.
#  .env в git НЕ попадает (см. .gitignore). Реальные секреты сюда не пишем.
# =========================================================================

# --- Среда исполнения ---
# local | production. Влияет только на логи/`/version` (трассировка), не на
# поведение кода. Локально оставляем local, на боевом сервере — production.
ENVIRONMENT=local

# --- Telegram ---
# У проекта ОДИН бот, его токен живёт только в .env на боевом сервере.
# Локально BOT_TOKEN оставляем ПУСТЫМ: пустой токен = контейнер бота не поллит
# (гард в app/main.py). Вписать сюда боевой токен нельзя — два процесса на одном
# токене дают 409 Conflict у Telegram, и сообщения реальных клиентов начнёт
# перехватывать твоя машина.
BOT_TOKEN=

# --- PostgreSQL (Neon) ---
# Приложение ходит через ПУЛЕР (-pooler хост). Для asyncpg за PgBouncer
# в config.py выставляется statement_cache_size=0.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/novapostbot?ssl=require
# Alembic-миграции — ПРЯМОЙ (non-pooled) коннект (без -pooler).
DATABASE_URL_DIRECT=postgresql+asyncpg://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/novapostbot?ssl=require
# Пул коннектов имеет дефолты в app/config.py — задавать НЕ обязательно
# (DB_POOL_SIZE=20, DB_MAX_OVERFLOW=30, DB_POOL_TIMEOUT=10, DB_POOL_RECYCLE=300).
# Дефолты SQLAlchemy (5+10, таймаут 30 с) нам не подходят: коннект удерживается
# через внешнее I/O — вызовы НП и Sheets идут внутри апдейта, при котором сессия
# открыта. Короткий таймаут = быстрый понятный отказ вместо полминуты тишины.

# --- Redis (FSM / кэш справочников НП) ---
REDIS_URL=redis://redis:6379/0

# --- Шифрование ключей НП (Fernet) ---
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- Нова Пошта ---
# Ключ НП у каждого ФОП свой — он шифруется в БД (Fernet), сюда его НЕ пишем.
# Транспорт/тайминги/TTL кэша имеют дефолты в app/config.py — задавать НЕ обязательно
# (NP_API_URL, NP_TIMEOUT_SECONDS, NP_MAX_RETRIES, NP_RETRY_BACKOFF, NP_*_TTL_SECONDS).
#
# Ref города и відділення НАШЕГО склада-отправителя в справочнике НП.
# ОБЯЗАТЕЛЬНО заполнить перед боевым запуском — иначе расчёт цены и створення ТТН
# вернут «розрахунок недоступний» / помилку. (Ref берём через Address.getCities /
# getWarehouses или из ЛК НП.) Сейчас оставлены пустыми — заполним при настройке прод.
NP_SENDER_CITY_REF=
NP_SENDER_WAREHOUSE_REF=

# --- Google Sheets (только склад) ---
# Источник КОЛИЧЕСТВА на складе: `sheets` (книга «Склад», текущий прод), `pg`
# (таблица `stock_balances`) или `crm` (заглушка-интеграционный seam Фазы 7).
# Откат с `pg` — сменой этой переменной и рестартом: ни пересборки, ни миграции вниз.
# Ретраи ЧТЕНИЯ склада на временную недоступность (квота 429, 5xx) имеют дефолты в
# app/config.py — задавать НЕ обязательно (SHEETS_RETRY_ATTEMPTS, SHEETS_RETRY_BACKOFF).
# Квота Google — 60 read/min на service-account, то есть на весь бот. Записи не
# ретраятся: они могли примениться частично, и повтор удвоил бы дельту остатка.
INVENTORY_SOURCE=sheets
# Сколько секунд переиспользовать прочитанный лист «Склад» между апдейтами.
# Квота Google — 60 чтений/мин на service-account, то есть на ВЕСЬ бот, а один
# сценарий створення ТТН делает ~8 чтений: без кэша потолок ≈7 ТТН/мин на всех
# клиентов, дальше 429 и «Склад тимчасово недоступний». Гейт от oversell кэш не
# читает — перед сверкой корзины лист перечитывается принудительно. 0 — выключить.
STOCK_CACHE_TTL_SECONDS=45
# Путь к JSON service-account (файл кладём в ./secrets/, он в .gitignore).
GOOGLE_SA_JSON=./secrets/service-account.json
SHEETS_STOCK_BOOK_ID=
SHEETS_INTAKE_BOOK_ID=

# --- Роли (Telegram ID через запятую) ---
OWNER_TELEGRAM_IDS=
DEV_TELEGRAM_IDS=

# --- Прочее ---
TIMEZONE=Europe/Kyiv
LOG_LEVEL=INFO

# --- Воркер / SLA ---
# JSON-расписание рабочих часов отделения: ключ = weekday() Python (0=пн ... 6=нд).
# Пусто = дефолт «все 7 дней 08:00-20:00» (склад и НП работают без выходных).
# От этого расписания зависят СРАЗУ ДВЕ вещи, и обе молча: гейт воркера
# (`_should_run_daytime` — вне окна трекинг и low-stock не идут) и дедлайн SLA
# (`add_working_minutes` пропускает нерабочие часы и выходные). День, забытый
# здесь, = день без трекинга + сдвинутый на сутки дедлайн. Фактическое расписание
# бот и воркер печатают в лог на старте (`work_schedule.effective`) — сверяйте там.
WORK_SCHEDULE={"0":["08:00","20:00"],"1":["08:00","20:00"],"2":["08:00","20:00"],"3":["08:00","20:00"],"4":["08:00","20:00"],"5":["08:00","20:00"],"6":["08:00","20:00"]}
TRACKING_POLL_SECONDS=180
# Ингест приёмки: лист «Історія» книги «Склад» → `stock_balances`. Выключен по
# умолчанию и НЕ привязан к INVENTORY_SOURCE намеренно: порядок выкатки —
# сначала backfill балансов, потом ингест на наблюдении несколько дней, и только
# потом переключение чтения на PG. Включённый до backfill'а ингест построил бы
# баланс из одних приходов, без стартового остатка.
# Водораздел (`stock_intake_cursor`) заводится на ТЕКУЩЕМ конце журнала при первом
# проходе — backfill и включение должны попасть в одно окно, с замороженной
# кнопкой «Внести», иначе приёмка между ними потеряется или задвоится.
STOCK_INGEST_ENABLED=false
STOCK_INGEST_SECONDS=60
STOCK_INGEST_BATCH_LIMIT=500
# Зеркало Postgres → лист «Склад»: пишет ТОЛЬКО «Кількість» и «Резерв», забирает
# описательные поля (Назва/Категорія/Ціна) обратно в PG и принимает ручные правки
# количества прямо в ячейке. 300 секунд, а не 60: проход стоит чтение + запись на
# аккаунт, и при 20 аккаунтах минутный интервал съел бы две трети квоты Google.
STOCK_MIRROR_ENABLED=false
STOCK_MIRROR_SECONDS=300
# Предохранитель на ручную правку ячейки: правка больше этой величины (или уводящая
# в минус) НЕ применяется, значение возвращается из PG, владельцу уходит сообщение.
# Опечатка в разряд иначе становится реальным остатком, а гейт от oversell смотрит
# именно на него. 0 — снять ограничение (не рекомендуется).
STOCK_MANUAL_DELTA_LIMIT=100
# Бронь остатка на время похода в НП (гейт от oversell). TTL короткий: бронь живёт
# ровно на длину внешнего вызова плюс запас. Дворник снимает пережившие TTL —
# процесс мог упасть между фазами сабмита, и висящая бронь занижает доступный
# остаток, то есть мешает клиенту продать собственный товар.
STOCK_HOLD_TTL_SECONDS=300
STOCK_HOLD_SWEEP_SECONDS=120
# Сверка остатка: PG против листа и PG против собственного журнала движений.
# Отдельным переключателем от зеркала и ингеста намеренно: по порядку выкатки она
# работает в режиме наблюдения несколько дней ПЕРЕД включением зеркала и
# переключением чтения на PG. Ничего не чинит — только сообщает: «усыновить» число
# из листа значило бы превратить опечатку человека в разрешение продать чужое.
STOCK_RECONCILE_ENABLED=false
STOCK_RECONCILE_SECONDS=3600
LOW_STOCK_POLL_SECONDS=900
LOW_STOCK_THRESHOLD=3
# Период проверки авто-снятия дежурства (закрытие отделения), сек.
DUTY_CHECK_SECONDS=300
